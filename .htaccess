# ==========================================================================
#  public_html KÖK DİZİN .htaccess
#
#  Bu dosya SSH'ın olmadığı cPanel kurulumu içindir. Laravel'in web kökü
#  public/ dizinidir; burada tüm proje public_html içine kurulduğu için
#  istekleri public/ dizinine yönlendiriyoruz.
#
#  SSH VARSA BU DOSYAYA GEREK YOK: public_html'i doğrudan public/ dizinine
#  symlink yapmak hem daha temiz hem daha güvenli.
# ==========================================================================

# --- Hassas dosyaları kapat ----------------------------------------------
# Aşağıdaki rewrite zaten her isteği public/ dizinine taşıdığı için kök
# dizindeki dosyalar erişilemez. Bu blok ikinci savunma hattı: mod_rewrite
# bir gün kapanırsa kaynak kodu açığa çıkmasın.
RedirectMatch 404 (?i)^/(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|README\.md|DEPLOY\.md)$
#
# DİKKAT: listede `storage` YOK. Panelden yüklenen görseller (logo, favicon,
# OG görseli, iş kapakları) /storage/... adresinden servis ediliyor —
# public/storage bağı üzerinden. Buraya `storage` eklenirse tüm görseller
# 404 döner. Gerçek storage/ dizini zaten rewrite sayesinde erişilemez.
RedirectMatch 404 (?i)^/(app|bootstrap|config|database|lang|resources|routes|tests|vendor|node_modules)(/|$)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- HTTPS zorunlu ---------------------------------------------------
    # Sertifika kuruldu (2026-10-05), yönlendirme açıldı.
    # Açılmadığı sürece site hem http hem https üzerinden açılıyordu; arama
    # motoru bunu İKİ AYRI SİTE sayar ve sinyalleri ikiye böler.
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- İstekleri public/ dizinine taşı ---------------------------------
    # Zaten public/ ile başlayan istekleri tekrar yönlendirme (sonsuz döngü).
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
